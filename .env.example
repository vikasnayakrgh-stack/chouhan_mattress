# ── Supabase (Chouhan Mattress admin backend) ───────────────────────────────
# Project ref: hcfcpkldxegalkrwngog
# Get these from: Supabase Dashboard → Project Settings → API
#   NEXT_PUBLIC_SUPABASE_URL       = https://hcfcpkldxegalkrwngog.supabase.co
#   NEXT_PUBLIC_SUPABASE_ANON_KEY  = the "anon" / "public" key (publishable)
#   SUPABASE_SERVICE_ROLE_KEY      = the "service_role" key — SERVER ONLY, never NEXT_PUBLIC_
#
# SECURITY: never commit the service_role key. Keep it server-side only.

NEXT_PUBLIC_SUPABASE_URL=https://hcfcpkldxegalkrwngog.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=REPLACE_WITH_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=REPLACE_WITH_SERVICE_ROLE_KEY

# Feature flag — when "supabase", the repository layer uses the live backend.
# When "mock" (default), it uses the in-memory mock data (no backend needed).
NEXT_PUBLIC_DATA_SOURCE=mock
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Payment Gateway Configuration (Razorpay - Primary) ────────────────────────
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_placeholder_key_id
RAZORPAY_KEY_ID=rzp_test_placeholder_key_id
RAZORPAY_KEY_SECRET=placeholder_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=placeholder_razorpay_webhook_secret

# ── Payment Gateway Configuration (Stripe - Secondary Fallback) ───────────────
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_placeholder_publishable_key
STRIPE_SECRET_KEY=sk_test_placeholder_secret_key
STRIPE_WEBHOOK_SECRET=whsec_placeholder_webhook_secret

# ── Logistics & Courier Configuration (Shiprocket - Primary) ──────────────────
SHIPROCKET_EMAIL=operations@chouhanmattress.com
SHIPROCKET_PASSWORD=placeholder_shiprocket_password
SHIPROCKET_WEBHOOK_TOKEN=placeholder_shiprocket_webhook_token

# ── Logistics & Courier Configuration (Delhivery - Direct Fallback) ────────────
DELHIVERY_API_TOKEN=placeholder_delhivery_api_token
DELHIVERY_CLIENT_ID=placeholder_delhivery_client_id

