# ── Supabase (Chouhan Mattress admin backend) ───────────────────────────────
# Project ref: hcfcpkldxegalkrwngog
# Get these from: Supabase Dashboard → Project Settings → API
#   NEXT_PUBLIC_SUPABASE_URL       = https://hcfcpkldxegalkrwngog.supabase.co
#   NEXT_PUBLIC_SUPABASE_ANON_KEY  = the "anon" / "public" key (publishable)
#   SUPABASE_SERVICE_ROLE_KEY      = the "service_role" key — SERVER ONLY, never NEXT_PUBLIC_
#
# SECURITY: never commit the service_role key. Keep it server-side only.

NEXT_PUBLIC_SUPABASE_URL=https://hcfcpkldxegalkrwngog.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=REPLACE_WITH_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=REPLACE_WITH_SERVICE_ROLE_KEY

# Feature flag — when "supabase", the repository layer uses the live backend.
# When "mock" (default), it uses the in-memory mock data (no backend needed).
NEXT_PUBLIC_DATA_SOURCE=mock
